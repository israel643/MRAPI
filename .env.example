# Puerto HTTP del servidor
PORT=3000
NODE_ENV=development

# Conexión MySQL (obligatorias: DB_HOST, DB_USER, DB_NAME)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Opcionales
DB_POOL_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000

# Secreto JWT (obligatorio, mínimo 32 caracteres aleatorios).
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_KEY=
JWT_EXPIRES_IN=1h

# Orígenes permitidos para CORS separados por comas (p. ej. http://localhost:5173).
# Vacío = cualquier origen (no recomendado en producción).
CORS_ORIGINS=

# Número de proxies inversos delante de la API (0 si no hay ninguno).
TRUST_PROXY=0
